# Production URL and GitHub Pages project path. Leave BASE_PATH as / for a
# username/organisation site; use /repository-name for a project site.
SITE_URL=https://your-github-username.github.io
BASE_PATH=/repository-name

# Formspree endpoint for the live bulk enquiry form. This is public by design
# and must be created/verified in the CPH Formspree account before launch.
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
