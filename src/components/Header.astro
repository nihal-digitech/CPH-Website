---
import { navigation, site } from '../data/site';
---

<header class="site-header">
  <div class="container header__inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand__mark" aria-hidden="true"><img src="/images/brand/cph-logo-original.jpg" alt="" /></span>
      <span class="brand__name">Cannanore<br />Plastic House</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.slice(1).map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="header__cta" href="/bulk-enquiry/">Bulk Enquiry</a>

    <details class="mobile-nav">
      <summary><span class="sr-only">Open navigation</span><span aria-hidden="true">Menu</span></summary>
      <nav aria-label="Mobile navigation">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="button button--accent" href="/bulk-enquiry/">Bulk Enquiry</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { position: sticky; z-index: 20; top: 0; border-bottom: 1px solid var(--line); background: rgb(251 250 248 / 94%); backdrop-filter: blur(12px); }
  .header__inner { display: flex; align-items: center; min-height: 4.75rem; gap: 1.2rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--ink); font-weight: 800; text-decoration: none; }
  .brand__mark { display: block; width: 2.35rem; aspect-ratio: 1; overflow: hidden; border-radius: 0.45rem; background: var(--slate); }
  .brand__mark img { width: 100%; height: 100%; object-fit: cover; }
  .brand__name { font-size: 0.72rem; line-height: 1.1; letter-spacing: 0.06em; text-transform: uppercase; }
  .desktop-nav { display: flex; align-items: center; gap: clamp(0.75rem, 2vw, 1.5rem); margin-left: auto; }
  .desktop-nav a { color: var(--muted); font-size: 0.89rem; font-weight: 700; text-decoration: none; }
  .desktop-nav a:hover { color: var(--ink); }
  .header__cta { padding: 0.57rem 0.85rem; border-radius: 999px; background: var(--ink); color: #fff; font-size: 0.85rem; font-weight: 750; text-decoration: none; }
  .mobile-nav { display: none; margin-left: auto; }
  .mobile-nav summary { cursor: pointer; font-size: 0.85rem; font-weight: 750; list-style: none; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav nav { position: absolute; top: calc(100% + 0.5rem); right: 0.65rem; display: grid; width: min(19rem, calc(100vw - 1.3rem)); gap: 0.25rem; padding: 0.7rem; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; box-shadow: var(--shadow); }
  .mobile-nav nav a:not(.button) { padding: 0.65rem 0.7rem; color: var(--ink); font-weight: 700; text-decoration: none; }
  @media (max-width: 58rem) { .desktop-nav, .header__cta { display: none; } .mobile-nav { display: block; } }
</style>
