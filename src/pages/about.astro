---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---

<BaseLayout title="About Cannanore Plastic House | CPH Kannur" description="Learn about Cannanore Plastic House, a Kannur retailer serving household and commercial product needs since 1968.">
  <PageHero eyebrow="About CPH" title="Serving Kannur since 1968." description="Cannanore Plastic House is an established local destination for household needs and practical commercial product solutions." />
  <section class="section"><div class="container story"><div><p class="eyebrow">Our story</p><h2 class="section-heading">A wide range, for many kinds of customer.</h2></div><div><p>For decades, CPH has served customers in Kannur with household plastics, kitchen essentials, storage, cleaning products, packaging materials and more.</p><p>Today, the product range also supports commercial buyers—from hotels and restaurants to retailers, industrial operations, agricultural businesses and construction requirements.</p><p>Our focus is simple: make it easier to find practical products for the home, showroom and workplace.</p></div></div></section>
  <section class="section section--canvas"><div class="container photo-grid"><img src={`${import.meta.env.BASE_URL}images/showroom/showroom-05.webp`} loading="lazy" alt="CPH showroom interior" /><img src={`${import.meta.env.BASE_URL}images/showroom/showroom-06.webp`} loading="lazy" alt="CPH showroom interior" /><img src={`${import.meta.env.BASE_URL}images/showroom/showroom-07.webp`} loading="lazy" alt="CPH showroom interior" /></div></section>
  <section class="section"><div class="container promise"><div><p class="eyebrow">What CPH offers</p><h2 class="section-heading">A useful choice for individual and commercial requirements.</h2></div><ul><li><span>01</span> Household, kitchen, storage and cleaning essentials</li><li><span>02</span> Packaging, takeaway and disposable product categories</li><li><span>03</span> Commercial, industrial, agricultural and construction supplies</li><li><span>04</span> A local Kannur showroom and direct enquiry options</li></ul></div></section>
  <section class="visit-cta"><div class="container"><p class="eyebrow">Visit CPH</p><h2>See the range in person on M.A. Road.</h2><p>{site.openingHours}</p><a class="button button--light" href="/visit-us/">Plan your visit</a></div></section>
</BaseLayout>

<style>
  .story, .promise { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 8vw, 9rem); }
  .story > div:last-child { color: var(--muted); font-size: 1.06rem; } .story > div:last-child p:first-child { margin-top: 0; }
  .photo-grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 1rem; }
  .photo-grid img { width: 100%; height: 22rem; border-radius: var(--radius); object-fit: cover; } .photo-grid img:first-child { height: 26rem; }
  .promise ul { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .promise li { display: grid; grid-template-columns: 2.7rem 1fr; padding: 1rem 0; border-bottom: 1px solid var(--line); font-weight: 750; } .promise span { color: var(--accent-deep); font-size: 0.75rem; font-weight: 850; }
  .visit-cta { padding-block: clamp(3.5rem, 7vw, 6rem); background: var(--slate-deep); color: #fff; } .visit-cta .eyebrow { color: #e5ba9f; } .visit-cta h2 { max-width: 17ch; margin: 0; font-size: clamp(1.9rem, 4vw, 3.4rem); letter-spacing: -0.05em; } .visit-cta p:not(.eyebrow) { color: rgb(255 255 255 / 75%); } .visit-cta .button { margin-top: 0.75rem; }
  @media (max-width: 46rem) { .story, .promise { grid-template-columns: 1fr; } .photo-grid { grid-template-columns: 1fr; } .photo-grid img, .photo-grid img:first-child { height: 20rem; } }
</style>
